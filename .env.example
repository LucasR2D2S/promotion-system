# Copy to .env (git-ignored) and adjust. docker compose reads .env automatically.

# --- AI provider (any OpenAI-compatible Chat Completions API) ---
# Ollama on the host machine (default, no key needed). Download the model first:
#   ollama pull qwen2.5:7b      (4.7 GB; lighter but weaker copy: llama3.2, 2 GB)
AI_BASE_URL=http://host.docker.internal:11434/v1
AI_MODEL=qwen2.5:7b
AI_API_KEY=

# Groq:
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=<model id from console.groq.com/docs/models>
# AI_API_KEY=gsk_...

# OpenAI:
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=<model id>
# AI_API_KEY=sk-...
