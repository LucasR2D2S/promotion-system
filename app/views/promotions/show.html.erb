<%= link_to 'Voltar', promotions_path %>
<hr>
<h1>Promoção <%= @promotion.name %> </h1>
<dl>
  <dt>Descrição: </dt>
  <dd> <%= @promotion.description %> </dd>
  <hr> 
  <dt>Porcentagem de desconto: </dt>
  <dd> <%= number_to_percentage @promotion.discount_rate, precision: 2, separator: ',' %> </dd>
  <hr>
  <dt>Codigo: </dt>
  <dd> <%= @promotion.code %> </dd>
  <hr>
  <dt>Vencimento: </dt>
  <dd> <%= @promotion.expiration_date.strftime("%d/%m/%Y") %> </dd>
  <hr>
  <dt>Quantidade: </dt>
  <dd> <%= @promotion.coupon_quantity %> </dd>
  <hr>
  <dt>Cadastrada por: <%= @promotion.user.email %> </dt>
  <hr>
  <% if @promotion.approved? %>
    <dt>Status:</dt> <dd>Aprovada</dd>
  <% else %>
    <dt>Status:</dt> <dd>Aguardando Aprovação</dd>
  <% end %>
  <hr>
</dl>

<h2>Categoria de Produtos</h2>

<% @promotion.categories.each do |pc| %>
  <%= pc.name %> - <%= pc.code %>
<% end %>

<% if current_user != @promotion.user %>
  <%= button_to 'Aprovar Promoção', approve_promotion_path(@promotion) %>
<% end %>
<hr>
<% unless @promotion.expired? %>
  <%# data-turbo=false: Turbo only accepts redirects or 4xx/5xx as form responses %>
  <%= button_to 'Gerar e-mail marketing com IA', marketing_copy_promotion_path(@promotion),
                form: { data: { turbo: false } } %>
  <small>O texto é gerado por IA e pode levar alguns segundos.</small>
  <hr>
<% end %>
<% unless @promotion.coupons_fully_generated? %>
  <%= button_to 'Gerar cupons', generate_coupons_promotion_path(@promotion) %>
  <hr>
<% end %>

<% @promotion.coupons.includes(:redemption).each do |coupon| %>
  <div id="coupon-<%= coupon.id %>">
    <span><%= coupon.code %> (<%= t(".#{coupon.status}") %><%= " no pedido #{coupon.redemption.order_reference}" if coupon.redemption %>)</span>
    <% if coupon.able? %>
      <%= button_to 'Desabilitar', disable_coupon_path(coupon), form: { style: 'display: inline' } %>
    <% elsif coupon.disable? %>
      <%= button_to 'Habilitar', able_coupon_path(coupon), form: { style: 'display: inline' } %>
    <% end %>
  </div>
<% end %>

<hr>
<%= link_to 'Registrar uma promoção', new_promotion_path %>
<hr>
<%= link_to 'Editar promoção', edit_promotion_path(@promotion) %>
<hr>
<%= button_to "Apagar promoção", promotion_path(@promotion), method: :delete,
                                form: { data: { turbo_confirm: "Você tem certeza?" } } %>
